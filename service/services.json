{
	"id": "com.palm.stark.files.service",
	"description": "Lists, copies, moves and deletes files for the Topaz Explorer app",
	"engine": "node",
	"activityTimeout": 120,
	"services": [
		{
			"name": "com.palm.stark.files.service",
			"globalized": false,
			"commands": [
				{ "name": "list", "assistant": "listAssistant", "public": true },
				{ "name": "search", "assistant": "searchAssistant", "public": true },
				{ "name": "details", "assistant": "detailsAssistant", "public": true },
				{ "name": "space", "assistant": "spaceAssistant", "public": true },
				{ "name": "read", "assistant": "readAssistant", "public": true },
				{ "name": "write", "assistant": "writeAssistant", "public": true },
				{ "name": "mkdir", "assistant": "mkdirAssistant", "public": true },
				{ "name": "rename", "assistant": "renameAssistant", "public": true },
				{ "name": "unlock", "assistant": "unlockAssistant", "public": true },
				{ "name": "netOpen", "assistant": "netOpenAssistant", "public": true },
				{ "name": "netClose", "assistant": "netCloseAssistant", "public": true },
				{ "name": "netList", "assistant": "netListAssistant", "public": true },
				{ "name": "netRename", "assistant": "netRenameAssistant", "public": true },
				{ "name": "netMkdir", "assistant": "netMkdirAssistant", "public": true },
				{ "name": "netGet", "assistant": "netGetAssistant", "public": true },
				{ "name": "netPut", "assistant": "netPutAssistant", "public": true },
				{ "name": "netSearch", "assistant": "netSearchAssistant", "public": true },
				{ "name": "driveCheck", "assistant": "driveCheckAssistant", "public": true },
				{ "name": "driveAccounts", "assistant": "driveAccountsAssistant", "public": true },
				{ "name": "nextcloudAccounts", "assistant": "nextcloudAccountsAssistant", "public": true },
				{ "name": "share", "assistant": "shareAssistant", "public": true },
				{ "name": "shareStatus", "assistant": "shareStatusAssistant", "public": true },
				{ "name": "start", "assistant": "startAssistant", "public": true },
				{ "name": "status", "assistant": "statusAssistant", "public": true },
				{ "name": "cancel", "assistant": "cancelAssistant", "public": true },
				{ "name": "quit", "assistant": "quitAssistant", "public": true }
			]
		}
	]
}
